text


import pandas as pd

titles = []
dates = []
contents = []
related_topics = []

# collect data from all the articles
for ix, url in enumerate(topic_urls):
    r = requests.get(url, headers=headers)
    soup = BeautifulSoup(r.content, "html.parser")
    titles.append(soup.title.string.strip())
    
    date_tag = soup.find_all("meta", property="article:published_time")
    if (len(date_tag) > 0):
        dates.append(datetime.strptime(date_tag[0]["content"], "%Y-%m-%dT%H:%M:%S+00:00"))
    else:
        try:
            date_str = soup.find(string=re.compile(r"\w*Published.*")).string.strip()
            # extract date
            date_str = date_str.split("PublishedDt: '")[1].split("',")[0].strip()
            dates.append(datetime.strptime(date_str, "%Y-%m-%d %H:%M:%S"))
        except:
            print(url)
            dates.append(None)
    
    post_classes = ["special-execution-wrapper", "article-content-container", "story-area"]

    text = ""
    
    for post_class in post_classes:
        if len(container := soup.find_all(class_=post_class)) > 0:
            paragraphs = container[0].find_all("p")
            for p in paragraphs:
                for p_string in p.strings:
                    text += p_string.strip() + " "
            break
    contents.append(text)

    try:
        related_links = soup.find('div', class_="related-topics-links").stripped_strings
        related_topics.append(','.join(list(related_links)))
    except:
        related_topics.append("None")

    print(f"{ix+1} out of {len(topic_urls)} processed")

print("Done")


df = pd.DataFrame({ 'Title': titles, 'Url': topic_urls, 'Publish Date': dates, 'Content': contents, 'Related Topics': related_topics })
df


df.to_excel("rappler.xlsx")



